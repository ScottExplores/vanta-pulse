    "optimize:art": "node scripts/optimize-art.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.2.8",
    "@fontsource/orbitron": "5.2.8",
    "pixi.js": "8.19.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "26.1.0",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
